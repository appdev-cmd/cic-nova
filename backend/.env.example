NOVA_ENV=development
NOVA_JWT_SECRET=replace-with-at-least-32-random-characters
NOVA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NOVA_MAX_UPLOAD_BYTES=26214400
NOVA_SLOW_REQUEST_MS=2000

# Supabase/PostgreSQL connection
SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=replace-me
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_CONNECT_TIMEOUT=10
